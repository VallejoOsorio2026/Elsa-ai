# --- Entorno y secretos (nunca se versionan) ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Documentos que nunca se versionan: manuales, planos, exportes SAP ---
*.pdf
*.dwg
*.dxf
*.tif
*.tiff
*.xls
*.xlsx
*.xlsm
*.mdb

# Exportes HTML de SAP (IH06, IW13, listas de materiales). Son información
# interna de planta: se importan desde una ruta local privada y jamás entran
# aquí. Los fixtures de la suite son cadenas dentro del código, no archivos.
*.htm
*.mht
*.mhtml

# Los patrones de .gitignore distinguen mayúsculas y los exportes de SAP
# llegan a menudo con la extensión en mayúscula (`TAMPELLA_BOM.HTM`). Cada
# variante hay que declararla; omitirlas dejaría pasar el archivo real.
*.HTM
*.MHT
*.XLS
*.XLSX
*.XLSM
*.PDF
*.DWG
*.DXF

# --- Almacenamiento privado de artefactos (Bloque 2) ---
# Originales importados y derivados (imágenes de plano). La ruta es
# configurable (ELSA_ARTIFACT_STORAGE_ROOT) y debería vivir FUERA del
# repositorio; estas entradas cubren el caso de que alguien la apunte dentro.
.artifacts/
artifacts/
private/

# Reportes de la prueba de aceptación privada: contienen conteos y hashes de
# datos reales y nunca se versionan.
acceptance/
reports/

# --- Pesos de modelos ---
*.gguf
*.GGUF
*.safetensors
*.pt
*.pth
*.onnx
*.ckpt

# --- Runtime de generación local (Bloque 4.5) ---
# Ni los binarios de llama.cpp ni el modelo ni los logs del servidor entran
# aquí. El GGUF de Phi-4-mini pesa más de 2 GB, los binarios dependen de la
# máquina y del backend de cómputo (Vulkan, CPU, CUDA) y los logs del
# servidor pueden llegar a contener el texto de las evidencias enviadas.
llama.cpp/
llama-server
llama-cli
*.exe
*.dll
models/
# Caché de Hugging Face si alguien la apunta dentro del repositorio.
.cache/
huggingface/

# --- Datasets y dumps de base de datos ---
data/
datasets/
*.parquet
*.csv
*.jsonl
*.dump
*.bak
*.sql.gz
# Volcados de Supabase. `*.sql` no puede ignorarse en bloque porque las
# migraciones también lo son, así que se ignoran por prefijo de nombre.
respaldo-*.sql
backup-*.sql
dump-*.sql
*.sqlite
*.sqlite3
*.db

# --- Supabase CLI: estado local efímero (las migraciones SÍ se versionan) ---
supabase/.temp/

# --- Editores y sistema operativo ---
.idea/
.vscode/
.DS_Store
