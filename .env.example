# Configuración de ELSA — copia este archivo a `.env` y ajusta los valores.
#
#     cp .env.example .env
#
# Ninguna clave de este archivo lleva valores secretos. Los secretos reales
# (cuando existan en bloques posteriores) solo viven en `.env`, que está en
# `.gitignore`. Referencia completa: docs/environment-variables.md

# Ambiente lógico. Valores permitidos: DEV | TEST. Obligatoria.
ELSA_ENV=DEV

# Orígenes CORS permitidos, separados por coma. Explícitos, sin comodines.
# Obligatoria. En TEST se declaran los orígenes propios de ese ambiente.
ELSA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL. Opcional (INFO).
ELSA_LOG_LEVEL=INFO

# Verbosidad de depuración (true/false). Solo permitido en DEV. Opcional (false).
# Nunca expone trazas internas al cliente; solo sube el nivel de log.
ELSA_DEBUG=false
