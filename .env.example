# Configuración de ELSA — copia este archivo a `.env` y ajusta los valores.
#
#     cp .env.example .env
#
# Ninguna clave de este archivo lleva valores secretos. Los secretos reales
# solo viven en `.env`, que está en `.gitignore`, o en el gestor de secretos
# del entorno de despliegue. Referencia: docs/environment-variables.md

# ============================================================
# General
# ============================================================

# Ambiente lógico. Valores permitidos: DEV | TEST. Obligatoria.
ELSA_ENV=DEV

# Orígenes CORS permitidos, separados por coma. Explícitos, sin comodines.
# Obligatoria. En TEST se declaran los orígenes propios de ese ambiente.
ELSA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL. Opcional (INFO).
ELSA_LOG_LEVEL=INFO

# Verbosidad de depuración (true/false). Solo permitido en DEV. Opcional (false).
# Nunca expone trazas internas al cliente; solo sube el nivel de log.
ELSA_DEBUG=false

# ============================================================
# Identidad — Asistente de Materiales
#
# Materiales = identidad. ELSA = autorización (ADR 0002 y ADR 0005).
# ============================================================

# Adaptador del puerto `auth`: supabase | fake.
# `fake` usa identidades deterministas en memoria y SOLO es válido en DEV.
ELSA_AUTH_PROVIDER=fake

# URL del proyecto Supabase de Materiales, sin barra final.
# Obligatoria con ELSA_AUTH_PROVIDER=supabase. No es un secreto.
ELSA_MATERIALS_SUPABASE_URL=

# Clave publicable de Materiales (`sb_publishable_...` o `anon`). Pública por
# diseño: sin sesión válida no devuelve ninguna fila. Se usa como cabecera
# `apikey` para comprobar el perfil propio del usuario con su propio JWT.
ELSA_MATERIALS_API_KEY=

# Algoritmos de firma aceptados, separados por coma. Opcional (ES256,RS256).
# Cualquier algoritmo fuera de la lista se rechaza; `none` no es configurable.
# Si Materiales firmara de forma simétrica (proyecto legacy), aquí iría HS256
# y habría que definir ELSA_AUTH_JWT_SECRET.
ELSA_AUTH_JWT_ALGORITHMS=ES256,RS256

# Audiencia esperada en el claim `aud`. Opcional (authenticated).
# Vacío desactiva la comprobación.
ELSA_AUTH_JWT_AUDIENCE=authenticated

# Emisor y JWKS. Opcionales: por defecto se derivan de
# ELSA_MATERIALS_SUPABASE_URL como `<url>/auth/v1` y
# `<url>/auth/v1/.well-known/jwks.json`.
ELSA_AUTH_JWT_ISSUER=
ELSA_AUTH_JWKS_URL=

# SECRETO. Solo si se acepta un algoritmo HS*. Nunca se versiona.
ELSA_AUTH_JWT_SECRET=

# Ajustes finos de la verificación. Opcionales.
ELSA_AUTH_JWT_LEEWAY_SECONDS=10
ELSA_AUTH_TIMEOUT_SECONDS=5.0
ELSA_AUTH_JWKS_CACHE_SECONDS=600
ELSA_AUTH_JWKS_MIN_REFRESH_SECONDS=60

# ============================================================
# Autorización — Supabase ELSA
# ============================================================

# Almacén de permisos: postgres | memory.
# `memory` no persiste y SOLO es válido en DEV.
ELSA_PERMISSIONS_BACKEND=memory

# SECRETO. Cadena de conexión a Supabase ELSA. Credencial exclusiva del
# servidor: nunca en el frontend, nunca en el repositorio, nunca en logs.
# Obligatoria con ELSA_PERMISSIONS_BACKEND=postgres.
ELSA_DATABASE_URL=

ELSA_DATABASE_POOL_MIN_SIZE=1
ELSA_DATABASE_POOL_MAX_SIZE=10

# SECRETO. Habilita el bootstrap del primer administrador. Sin valor, el
# endpoint POST /api/v1/admin/bootstrap queda deshabilitado. Genera uno
# aleatorio (p. ej. `openssl rand -hex 32`), úsalo una vez y bórralo.
ELSA_BOOTSTRAP_ADMIN_TOKEN=

# ============================================================
# Control de abuso (por usuario autenticado)
#
# No cubre el bloqueo por contraseñas fallidas: eso es de Supabase
# Materiales. Limitación conocida: los contadores son por proceso
# (ver docs/security.md). 0 = sin límite.
# ============================================================

ELSA_RATE_LIMIT_ENABLED=true
ELSA_RATE_LIMIT_REQUESTS_PER_MINUTE=60
ELSA_RATE_LIMIT_MAX_CONCURRENT_REQUESTS=5

# Sesiones ELSA simultáneas por usuario. Solo aplicable si el JWT trae un
# identificador de sesión fiable; ver la limitación en docs/security.md.
ELSA_MAX_SESSIONS_PER_USER=0
ELSA_SESSION_IDLE_TIMEOUT_SECONDS=1800
